MASSIVE_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET_KEY=

# Shared Finbot data root for direct local script runs.
# Durable reference datasets will write to ${FINBOT_DATA_ROOT}/reference.
# Daily bars will write to ${FINBOT_DATA_ROOT}/market/daily_bars.
# Raw provider responses will write beneath ${FINBOT_DATA_ROOT}/raw.
FINBOT_DATA_ROOT=../../data

# Optional per-dataset overrides. Defaults are derived from FINBOT_DATA_ROOT.
# FINBOT_REFERENCE_DIR=../../data/reference
# FINBOT_RAW_REFERENCE_DIR=../../data/raw/reference/us_equity_universe
# FINBOT_RAW_ALPACA_COVERAGE_DIR=../../data/raw/alpaca/coverage_audit
# FINBOT_RAW_ALPACA_NAME_CHANGES_DIR=../../data/raw/alpaca/name_changes
# FINBOT_RAW_ALPACA_CORPORATE_ACTIONS_DIR=../../data/raw/alpaca/corporate_actions
# FINBOT_RAW_ALPACA_BARS_DIR=../../data/raw/alpaca/daily_bars

# Host path mounted to /data by Docker Compose.
FINBOT_HOST_DATA_ROOT=../../data

# Used by the Docker entrypoint so bind-mounted output files are owned by your host user.
# Populate these on each machine with:
#   HOST_UID=$(id -u)
#   HOST_GID=$(id -g)
# Linux VMs commonly use 1000:1000, but confirm with the commands above.
# MacOS VMs commonly use 501:20, but confirm with the commands above.
HOST_UID=1000
HOST_GID=1000
