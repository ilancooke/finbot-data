NASDAQ_DATA_LINK_API_KEY=
MASSIVE_API_KEY=

# Shared Finbot data root for direct local script runs.
# Reference datasets write to ${FINBOT_DATA_ROOT}/reference.
# Daily bars write to ${FINBOT_DATA_ROOT}/market/daily_bars.
# Large downloaded exports write to ${FINBOT_DATA_ROOT}/raw/exports/daily_bars.
FINBOT_DATA_ROOT=../../data

# Host path mounted to /data by Docker Compose.
FINBOT_HOST_DATA_ROOT=../../data

# Used by the Docker entrypoint so bind-mounted output files are owned by your host user.
# Populate these on each machine with:
#   HOST_UID=$(id -u)
#   HOST_GID=$(id -g)
# Linux VMs commonly use 1000:1000, but confirm with the commands above.
# MacOS VMs commonly use 501:20, but confirm with the commands above.
HOST_UID=1000
HOST_GID=1000
